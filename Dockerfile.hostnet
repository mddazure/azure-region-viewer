# Alternative Dockerfile for host network deployment
# Use this when you need to preserve client IP addresses in direct VM deployments
FROM node:18-alpine
WORKDIR /usr/src/app
COPY package.json package-lock.json* ./
RUN npm install --production
COPY . .

# Default port - can be overridden with ENV var
ENV PORT=3000
# Use :: for dual-stack IPv4/IPv6 support
ENV HOST=::

# No EXPOSE needed in host network mode - app uses host's network directly
CMD ["node", "server.js"]